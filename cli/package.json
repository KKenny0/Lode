{
  "name": "@lode/cli",
  "version": "0.1.0",
  "description": "Persistent memory and decision replay for agentic coding — guided setup for Lode skills",
  "type": "module",
  "bin": {
    "lode": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run copy-skills && npm run check-skills",
    "copy-skills": "node scripts/copy-skills.mjs",
    "check-skills": "node scripts/check-skills.mjs",
    "test:doctor": "node scripts/test-doctor.mjs",
    "test": "npm run build && npm run test:doctor"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "inquirer": "^9.2.12",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9"
  }
}
